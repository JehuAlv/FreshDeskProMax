<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<title>Freshdesk Dashboard</title>
<HTA:APPLICATION
    ID="FDSetup"
    APPLICATIONNAME="FreshdeskDashboard"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="no"
    SCROLL="no"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
/>
<style>
body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, sans-serif;
    background: #f5f5f7;
    color: #1d1d1f;
    overflow: hidden;
}
.container {
    padding: 36px 44px 28px;
}
.header {
    text-align: center;
    margin-bottom: 30px;
}
.icon-box {
    width: 68px;
    height: 68px;
    margin: 0 auto 14px;
    background: #0071e3;
    border-radius: 16px;
    line-height: 68px;
    text-align: center;
    font-size: 24px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 1px;
}
.header h1 {
    font-size: 21px;
    font-weight: 600;
    color: #1d1d1f;
    margin: 0 0 4px;
    letter-spacing: -0.3px;
}
.header p {
    font-size: 13px;
    color: #86868b;
    margin: 0;
    font-weight: 400;
}
.bar-wrap {
    background: #d2d2d7;
    height: 4px;
    border-radius: 2px;
    margin-bottom: 24px;
    overflow: hidden;
}
.bar-fill {
    width: 0%;
    height: 4px;
    background: #0071e3;
    border-radius: 2px;
}
.step {
    padding: 9px 12px;
    margin-bottom: 3px;
    border-radius: 8px;
    background: transparent;
    overflow: hidden;
}
.step-num {
    display: inline-block;
    width: 24px;
    height: 24px;
    line-height: 24px;
    text-align: center;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    color: #86868b;
    background: #e8e8ed;
    margin-right: 12px;
    vertical-align: middle;
}
.step-text {
    display: inline-block;
    vertical-align: middle;
}
.step-name {
    font-size: 13px;
    font-weight: 500;
    color: #1d1d1f;
}
.step-status {
    font-size: 11px;
    color: #86868b;
    margin-top: 1px;
}
.step-active {
    background: #e8f0fe;
}
.step-active .step-num {
    background: #0071e3;
    color: #fff;
}
.step-active .step-status {
    color: #0071e3;
}
.step-done {
    background: #e8f8ee;
}
.step-done .step-num {
    background: #34c759;
    color: #fff;
}
.step-done .step-status {
    color: #248a3d;
}
.step-error {
    background: #feeced;
}
.step-error .step-num {
    background: #ff3b30;
    color: #fff;
}
.step-error .step-status {
    color: #ff3b30;
}
.footer-msg {
    text-align: center;
    margin-top: 20px;
    font-size: 12px;
    color: #86868b;
    min-height: 20px;
}
.footer-ok {
    color: #248a3d;
    font-weight: 600;
}
.footer-err {
    color: #ff3b30;
    font-weight: 600;
}
.log-link {
    display: inline-block;
    margin-top: 8px;
    padding: 6px 16px;
    font-size: 12px;
    color: #0071e3;
    background: #e8f0fe;
    border: 1px solid #0071e3;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
}
</style>
<script language="JScript">
var shell = new ActiveXObject("WScript.Shell");
var fso = new ActiveXObject("Scripting.FileSystemObject");
var installDir = "";
var logFile = null;
var tempDir = "";
var localApp = "";
var allOK = true;
var asyncCounter = 0;
var total = 7;
var errors = [];

function log(msg) {
    try {
        if (!logFile) {
            var logPath = installDir ? installDir + "\\setup.log" : shell.ExpandEnvironmentStrings("%TEMP%") + "\\fd-setup.log";
            logFile = fso.OpenTextFile(logPath, 8, true);
        }
        var d = new Date();
        var pad = function(n) { return n < 10 ? "0" + n : "" + n };
        var ts = d.getFullYear() + "-" + pad(d.getMonth()+1) + "-" + pad(d.getDate()) + " " + pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":" + pad(d.getSeconds());
        logFile.WriteLine("[" + ts + "] " + msg);
    } catch(e) {}
}

function formatTime(secs) {
    var m = Math.floor(secs / 60);
    var s = secs % 60;
    if (m > 0) return m + "m " + s + "s";
    return s + "s";
}

function readFirstLine(path) {
    try {
        if (!fso.FileExists(path)) return "";
        var f = fso.OpenTextFile(path, 1);
        if (f.AtEndOfStream) { f.Close(); return ""; }
        var line = f.ReadLine();
        f.Close();
        if (line.length > 80) line = line.substring(0, 80);
        return line;
    } catch(e) { return "" }
}

function addError(stepName, detail) {
    var msg = stepName + ": " + detail;
    errors.push(msg);
    log("ERROR - " + msg);
    allOK = false;
}

function openLog() {
    shell.Run('notepad "' + installDir + '\\setup.log"');
}

// Runs cmd async with stderr capture. Calls onDone(success, errorHint).
function runAsync(cmd, stepIdx, prefix, timeout, onDone) {
    asyncCounter++;
    var id = asyncCounter;
    var okFile = tempDir + "\\fd-async-" + id + ".ok";
    var failFile = tempDir + "\\fd-async-" + id + ".fail";
    var errFile = tempDir + "\\fd-async-" + id + ".err";
    try { fso.DeleteFile(okFile) } catch(e) {}
    try { fso.DeleteFile(failFile) } catch(e) {}
    try { fso.DeleteFile(errFile) } catch(e) {}
    if (!timeout) timeout = 1800;

    shell.Run('cmd /c (' + cmd + ' 2>"' + errFile + '") && echo x>"' + okFile + '" || echo x>"' + failFile + '"', 0, false);

    var elapsed = 0;
    var poller = function() {
        elapsed += 2;
        setStep(stepIdx, "active", prefix + "... " + formatTime(elapsed));

        var ok = false;
        var fail = false;
        try { ok = fso.FileExists(okFile) } catch(e) {}
        try { fail = fso.FileExists(failFile) } catch(e) {}

        if (ok) {
            try { fso.DeleteFile(okFile) } catch(e) {}
            try { fso.DeleteFile(errFile) } catch(e) {}
            log(prefix + " OK in " + formatTime(elapsed));
            onDone(true, "");
            return;
        }
        if (fail) {
            try { fso.DeleteFile(failFile) } catch(e) {}
            var hint = readFirstLine(errFile);
            try { fso.DeleteFile(errFile) } catch(e) {}
            log(prefix + " FAILED after " + formatTime(elapsed) + (hint ? " | " + hint : ""));
            onDone(false, hint);
            return;
        }
        if (elapsed >= timeout) {
            var hint2 = readFirstLine(errFile);
            try { fso.DeleteFile(errFile) } catch(e) {}
            log(prefix + " TIMEOUT after " + formatTime(elapsed));
            onDone(false, "Timeout (" + formatTime(elapsed) + ")" + (hint2 ? " | " + hint2 : ""));
            return;
        }
        setTimeout(poller, 2000);
    };
    setTimeout(poller, 2000);
}

// Downloads url to dest using fallback chain.
function downloadAsync(url, dest, stepIdx, prefix, timeout, onDone) {
    asyncCounter++;
    var doneFile = tempDir + "\\fd-async-" + asyncCounter + ".done";
    try { fso.DeleteFile(doneFile) } catch(e) {}
    try { fso.DeleteFile(dest) } catch(e) {}
    if (!timeout) timeout = 600;

    var cmd = '(certutil -urlcache -split -f "' + url + '" "' + dest + '" >nul 2>&1';
    cmd += ' || %SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -Command "[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12;(New-Object Net.WebClient).DownloadFile(\'' + url + '\',\'' + dest + '\')"';
    cmd += ' || bitsadmin /transfer FDDownload /priority high "' + url + '" "' + dest + '" >nul 2>&1)';
    cmd += ' & echo x>"' + doneFile + '"';

    shell.Run('cmd /c ' + cmd, 0, false);

    var elapsed = 0;
    var poller = function() {
        elapsed += 2;
        setStep(stepIdx, "active", prefix + "... " + formatTime(elapsed));

        try {
            if (fso.FileExists(doneFile)) {
                try { fso.DeleteFile(doneFile) } catch(e) {}
                var exists = fso.FileExists(dest);
                log(prefix + " finished in " + formatTime(elapsed) + ", file exists: " + exists);
                onDone(exists);
                return;
            }
        } catch(e) {}

        if (elapsed >= timeout) {
            log(prefix + " timed out after " + formatTime(elapsed));
            onDone(fso.FileExists(dest));
            return;
        }
        setTimeout(poller, 2000);
    };
    setTimeout(poller, 2000);
}

function refreshPath() {
    try {
        var syspath = shell.RegRead("HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\\Path");
        var usrpath = "";
        try { usrpath = shell.RegRead("HKCU\\Environment\\Path") } catch(e) {}
        var env = shell.Environment("PROCESS");
        env("PATH") = syspath + ";" + usrpath;
    } catch(e) {}
}

function resizeWin() {
    window.resizeTo(520, 640);
    window.moveTo((screen.width - 520) / 2, (screen.height - 640) / 2);
}

function getDir() {
    var p = "" + document.location.pathname;
    p = p.replace(/\//g, "\\");
    if (p.charAt(0) == "\\") p = p.substr(1);
    var idx = p.lastIndexOf("\\");
    if (idx > 0) p = p.substring(0, idx);
    return p;
}

function setStep(i, state, statusText) {
    var el = document.getElementById("step-" + i);
    var num = document.getElementById("num-" + i);
    var st = document.getElementById("st-" + i);

    el.className = "step";
    if (state == "active") {
        el.className = "step step-active";
        num.innerText = "...";
    } else if (state == "done") {
        el.className = "step step-done";
        num.innerHTML = "&#10003;";
    } else if (state == "error") {
        el.className = "step step-error";
        num.innerHTML = "&#10007;";
    }

    st.innerText = statusText;

    var pct = 0;
    for (var j = 0; j < total; j++) {
        var s = document.getElementById("step-" + j);
        if (s.className.indexOf("done") >= 0) pct++;
    }
    document.getElementById("bar").style.width = Math.round(pct / total * 100) + "%";
}

function run(cmd) { return shell.Run(cmd, 0, true) }

function hasInternet() {
    return run('cmd /c ping -n 1 -w 3000 8.8.8.8 >nul 2>nul') == 0;
}

function waitForInternet(stepIdx, onReady) {
    var elapsed = 0;
    var poll = function() {
        setStep(stepIdx, "error", "No internet - reconnecting... " + formatTime(elapsed));
        setTimeout(function() {
            if (hasInternet()) {
                log("Internet restored after " + formatTime(elapsed));
                onReady();
                return;
            }
            elapsed += 5;
            if (elapsed >= 300) {
                log("Internet wait timed out after 5m");
                onReady();
                return;
            }
            setTimeout(poll, 2000);
        }, 100);
    };
    poll();
}

function window_onload() {
    resizeWin();
    installDir = getDir();
    tempDir = shell.ExpandEnvironmentStrings("%TEMP%");
    localApp = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%");
    log("=== Freshdesk Dashboard Setup ===");
    log("Install dir: " + installDir);
    setTimeout(step0, 500);
}

// ── Step 0: Python ──
var pyUrl = "https://www.python.org/ftp/python/3.13.3/python-3.13.3-amd64.exe";

function step0() {
    log("Step 1: Python");
    setStep(0, "active", "Checking...");
    setTimeout(function() {
        var rc = run("cmd /c python --version");
        log("python --version: " + rc);
        if (rc != 0) {
            step0_download(1);
        } else {
            log("Already installed");
            setStep(0, "done", "Ready");
            setTimeout(step1, 50);
        }
    }, 50);
}

function step0_download(attempt) {
    if (attempt > 3) {
        setStep(0, "error", "Download failed (3 attempts)");
        addError("Python", "download failed after 3 attempts");
        setTimeout(step1, 50);
        return;
    }
    var pyFile = tempDir + "\\python-installer.exe";
    log("Python download attempt " + attempt);
    if (attempt > 1) setStep(0, "active", "Retrying download (" + attempt + "/3)...");
    downloadAsync(pyUrl, pyFile, 0, "Downloading Python", 600, function(ok) {
        if (ok) {
            step0_install(pyFile);
        } else {
            log("Download failed, checking internet...");
            if (!hasInternet()) {
                waitForInternet(0, function() { step0_download(attempt + 1) });
            } else {
                setTimeout(function() { step0_download(attempt + 1) }, 2000);
            }
        }
    });
}

function step0_install(pyFile) {
    log("Download OK, installing...");
    var installCmd = 'start /wait "" "' + pyFile + '" /quiet InstallAllUsers=1 PrependPath=1 Include_pip=1';
    runAsync(installCmd, 0, "Installing Python", 600, function(success, hint) {
        try { fso.DeleteFile(pyFile) } catch(e) {}
        refreshPath();
        var check = run("cmd /c python --version");
        log("Post-install check: " + check);
        if (check == 0) {
            setStep(0, "done", "Installed");
        } else {
            var detail = hint ? hint : "not found after install";
            setStep(0, "error", detail);
            addError("Python", detail);
        }
        setTimeout(step1, 50);
    });
}

// ── Step 1: Ollama ──
var ollamaUrl = "https://ollama.com/download/OllamaSetup.exe";

function step1() {
    log("Step 2: Ollama");
    setStep(1, "active", "Checking...");
    setTimeout(function() {
        var rc = run("cmd /c where ollama");
        log("where ollama: " + rc);
        if (rc != 0) {
            step1_download(1);
        } else {
            log("Already installed");
            setStep(1, "done", "Ready");
            setTimeout(step2, 50);
        }
    }, 50);
}

function step1_download(attempt) {
    if (attempt > 3) {
        setStep(1, "error", "Download failed (3 attempts)");
        addError("Ollama", "download failed after 3 attempts");
        setTimeout(step2, 50);
        return;
    }
    var ollFile = tempDir + "\\OllamaSetup.exe";
    log("Ollama download attempt " + attempt);
    if (attempt > 1) setStep(1, "active", "Retrying download (" + attempt + "/3)...");
    downloadAsync(ollamaUrl, ollFile, 1, "Downloading Ollama", 600, function(ok) {
        if (ok) {
            step1_install(ollFile);
        } else {
            log("Download failed, checking internet...");
            if (!hasInternet()) {
                waitForInternet(1, function() { step1_download(attempt + 1) });
            } else {
                setTimeout(function() { step1_download(attempt + 1) }, 2000);
            }
        }
    });
}

function step1_install(ollFile) {
    log("Download OK, installing...");
    var installCmd = 'start /wait "" "' + ollFile + '" /VERYSILENT /NORESTART';
    runAsync(installCmd, 1, "Installing Ollama", 600, function(success, hint) {
        try { fso.DeleteFile(ollFile) } catch(e) {}
        refreshPath();
        log("Ollama install finished, success=" + success);
        if (success) {
            setStep(1, "done", "Installed");
        } else {
            var detail = hint ? hint : "installer returned error";
            setStep(1, "error", detail);
            addError("Ollama", detail);
        }
        setTimeout(step2, 50);
    });
}

// ── Step 2: Environment ──
function step2() {
    log("Step 3: Environment");
    setStep(2, "active", "Configuring...");
    setTimeout(function() {
        run('cmd /c setx OLLAMA_HOST "0.0.0.0" /M');
        run('cmd /c setx OLLAMA_ORIGINS "*" /M');
        var env = shell.Environment("PROCESS");
        env("OLLAMA_HOST") = "0.0.0.0";
        env("OLLAMA_ORIGINS") = "*";
        log("Environment configured (OLLAMA_HOST=0.0.0.0, OLLAMA_ORIGINS=*)");
        setStep(2, "done", "Configured");
        setTimeout(step3, 50);
    }, 50);
}

// ── Step 3: Dependencies ──
function step3() {
    log("Step 4: Dependencies");
    setStep(3, "active", "Installing packages...");
    step3_pip(1);
}

function step3_pip(attempt) {
    if (attempt > 3) {
        setStep(3, "error", "Install failed (3 attempts)");
        addError("Dependencies", "pip install failed after 3 attempts");
        setTimeout(step4, 50);
        return;
    }
    log("pip install attempt " + attempt);
    if (attempt > 1) setStep(3, "active", "Retrying (" + attempt + "/3)...");
    var pipCmd = 'pip install -r "' + installDir + '\\Sharepoint\\requirements.txt" --quiet --no-warn-script-location';
    runAsync(pipCmd, 3, "Installing packages", 300, function(success, hint) {
        log("pip install done, success=" + success);
        if (success) {
            setStep(3, "done", "Installed");
            setTimeout(step4, 50);
        } else {
            log("pip failed, checking internet...");
            if (!hasInternet()) {
                waitForInternet(3, function() { step3_pip(attempt + 1) });
            } else {
                setTimeout(function() { step3_pip(attempt + 1) }, 2000);
            }
        }
    });
}

// ── Step 4: AI Model ──
function resolveOllamaExe() {
    refreshPath();
    var exe = localApp + "\\Programs\\Ollama\\ollama.exe";
    if (fso.FileExists(exe)) return exe;
    return "ollama";
}

function startOllamaServer(ollamaExe) {
    var ollamaApp = localApp + "\\Programs\\Ollama\\ollama app.exe";
    if (fso.FileExists(ollamaApp)) {
        log("Starting ollama app.exe with OLLAMA_HOST=0.0.0.0");
        shell.Run('cmd /c set OLLAMA_HOST=0.0.0.0 && start "" "' + ollamaApp + '"', 0, false);
    } else {
        log("Starting ollama serve with OLLAMA_HOST=0.0.0.0");
        shell.Run('cmd /c set OLLAMA_HOST=0.0.0.0 && "' + ollamaExe + '" serve', 0, false);
    }
}

function waitForOllama(ollamaExe, stepIdx, timeout, onReady) {
    var elapsed = 0;
    var check = function() {
        setStep(stepIdx, "active", "Starting server... " + formatTime(elapsed));
        setTimeout(function() {
            var rc = shell.Run('cmd /c set OLLAMA_HOST=http://127.0.0.1:11434 && "' + ollamaExe + '" list >nul 2>&1', 0, true);
            if (rc == 0) {
                log("Ollama server ready after " + formatTime(elapsed));
                onReady(true);
                return;
            }
            elapsed += 3;
            if (elapsed >= timeout) {
                log("Ollama server timeout after " + formatTime(elapsed));
                onReady(false);
                return;
            }
            setTimeout(check, 2000);
        }, 100);
    };
    check();
}

function doPull(ollamaExe, attempt) {
    if (!attempt) attempt = 1;
    if (attempt > 3) {
        setStep(4, "error", "Pull failed (3 attempts)");
        addError("AI Model", "pull failed after 3 attempts");
        setTimeout(step5, 50);
        return;
    }
    log("Model pull attempt " + attempt);
    if (attempt > 1) setStep(4, "active", "Retrying pull (" + attempt + "/3)...");
    var pullCmd = 'set OLLAMA_HOST=http://127.0.0.1:11434 && "' + ollamaExe + '" pull qwen3.5:9b';
    runAsync(pullCmd, 4, "Downloading model", 2400, function(success, hint) {
        if (success) {
            log("Pull finished, verifying model...");
            setStep(4, "active", "Verifying model...");
            setTimeout(function() {
                var listFile = tempDir + "\\fd-model-list.txt";
                try { fso.DeleteFile(listFile) } catch(e) {}
                shell.Run('cmd /c set OLLAMA_HOST=http://127.0.0.1:11434 && "' + ollamaExe + '" list >"' + listFile + '" 2>&1', 0, true);
                var found = false;
                var content = "";
                try {
                    if (fso.FileExists(listFile)) {
                        var f = fso.OpenTextFile(listFile, 1);
                        content = f.ReadAll();
                        f.Close();
                    }
                } catch(e) { content = "read error: " + e.message }
                log("ollama list output: [" + content.replace(/\r?\n/g, " | ") + "]");
                if (content.toLowerCase().indexOf("qwen3.5") >= 0) found = true;
                try { fso.DeleteFile(listFile) } catch(e) {}
                if (found) {
                    log("Model qwen3.5:9b verified");
                    setStep(4, "done", "qwen3.5:9b");
                } else {
                    setStep(4, "error", "Model not verified after download");
                    addError("AI Model", "pull completed but model not found in ollama list");
                }
                setTimeout(step5, 50);
            }, 100);
        } else {
            log("Pull failed, checking internet...");
            if (!hasInternet()) {
                waitForInternet(4, function() { doPull(ollamaExe, attempt + 1) });
            } else {
                setTimeout(function() { doPull(ollamaExe, attempt + 1) }, 2000);
            }
        }
    });
}

function step4() {
    log("Step 5: AI Model");
    setStep(4, "active", "Preparing...");
    setTimeout(function() {
        var ollamaExe = resolveOllamaExe();
        log("Resolved ollama: " + ollamaExe);

        var rc = shell.Run('cmd /c set OLLAMA_HOST=http://127.0.0.1:11434 && "' + ollamaExe + '" list >nul 2>&1', 0, true);
        if (rc == 0) {
            log("Ollama server already running");
            doPull(ollamaExe);
        } else {
            log("Ollama server not running, starting...");
            startOllamaServer(ollamaExe);
            waitForOllama(ollamaExe, 4, 120, function(ready) {
                if (ready) {
                    doPull(ollamaExe);
                } else {
                    setStep(4, "error", "Server timeout (120s)");
                    addError("AI Model", "Ollama server failed to start after 120s");
                    setTimeout(step5, 50);
                }
            });
        }
    }, 50);
}

// ── Step 5: Network ──
function step5() {
    log("Step 6: Network");
    setStep(5, "active", "Opening ports...");
    setTimeout(function() {
        run('cmd /c netsh advfirewall firewall delete rule name="FreshdeskDashboard-Proxy" >nul 2>&1');
        run('cmd /c netsh advfirewall firewall delete rule name="FreshdeskDashboard-Ollama" >nul 2>&1');
        run('cmd /c netsh advfirewall firewall add rule name="FreshdeskDashboard-Proxy" dir=in action=allow protocol=TCP localport=8080');
        run('cmd /c netsh advfirewall firewall add rule name="FreshdeskDashboard-Ollama" dir=in action=allow protocol=TCP localport=11434');
        log("Firewall configured");
        setStep(5, "done", "Ports 8080, 11434");
        setTimeout(step6, 50);
    }, 50);
}

// ── Step 6: Startup ──
function step6() {
    log("Step 7: Startup");
    setStep(6, "active", "Creating service...");
    setTimeout(function() {
        var ok = false;

        // Primary: per-user Startup shortcut. Needs no elevation, so it works
        // even when the HTA is launched by double-click instead of the installer.
        try {
            var startupDir = shell.SpecialFolders("Startup");
            var lnk = shell.CreateShortcut(startupDir + "\\FreshDeskProMax.lnk");
            lnk.TargetPath = "C:\\Windows\\System32\\wscript.exe";
            lnk.Arguments = '"' + installDir + '\\watchdog.vbs"';
            lnk.WorkingDirectory = installDir;
            lnk.Description = "FreshDesk Pro Max - proxy watchdog";
            lnk.WindowStyle = 7;
            lnk.Save();
            log("Startup shortcut created: " + startupDir + "\\FreshDeskProMax.lnk");
            ok = true;
        } catch(e) {
            log("Startup shortcut failed: " + e.message);
        }

        // Secondary: scheduled task. /rl highest needs elevation, so check the
        // exit code and retry unelevated rather than assuming success. /f
        // overwrites in place -- deleting first meant a failed create left no
        // task at all, while the log still claimed one had been created.
        var tn = '"FreshDeskProMax"';
        var tr = '"\\"' + installDir + '\\start.bat\\""';
        var rc = run('cmd /c schtasks /create /tn ' + tn + ' /tr ' + tr + ' /sc onlogon /rl highest /f >nul 2>&1');
        if (rc != 0) {
            log("schtasks with /rl highest failed (rc=" + rc + "), retrying unelevated");
            rc = run('cmd /c schtasks /create /tn ' + tn + ' /tr ' + tr + ' /sc onlogon /f >nul 2>&1');
        }
        if (rc == 0) {
            log("Scheduled task created (onlogon)");
            ok = true;
            // Drop the legacy task name so the proxy is not started twice.
            run('cmd /c schtasks /delete /tn "FreshdeskDashboard" /f >nul 2>&1');
        } else {
            log("Scheduled task creation failed (rc=" + rc + ")");
        }

        if (ok) {
            setStep(6, "done", "Auto-start enabled");
        } else {
            addError("Startup", "Could not enable auto-start: no Startup shortcut and no scheduled task");
            setStep(6, "done", "Auto-start unavailable");
        }
        setTimeout(stepFinish, 50);
    }, 50);
}

// ── Finish ──
function stepFinish() {
    log("Starting services...");
    shell.Run('cmd /c cd /d "' + installDir + '" && "' + installDir + '\\watchdog.bat" >>"' + installDir + '\\watchdog.log" 2>&1', 0, false);
    document.getElementById("bar").style.width = "100%";
    var msg = document.getElementById("msg");
    var logBtn = document.getElementById("log-btn");
    if (allOK) {
        log("Setup complete - all steps OK");
        msg.className = "footer-msg footer-ok";
        msg.innerText = "Setup complete. Opening dashboard...";
    } else {
        log("Setup completed with " + errors.length + " error(s):");
        for (var i = 0; i < errors.length; i++) {
            log("  - " + errors[i]);
        }
        msg.className = "footer-msg footer-err";
        msg.innerText = "Done with warnings: " + errors.join(" | ");
        logBtn.style.display = "block";
    }
    try { if (logFile) { logFile.Close() } } catch(e) {}
    setTimeout(function() {
        shell.Run("http://localhost:8080");
        setTimeout(function() { window.close() }, 2000);
    }, 3000);
}
</script>
</head>
<body onload="window_onload()">
<div class="container">
    <div class="header">
        <div class="icon-box">FD</div>
        <h1>Freshdesk Dashboard</h1>
        <p>Setting up your environment</p>
    </div>
    <div class="bar-wrap"><div class="bar-fill" id="bar"></div></div>
    <div id="step-list">
        <div class="step" id="step-0"><span class="step-num" id="num-0">1</span><span class="step-text"><div class="step-name">Python Runtime</div><div class="step-status" id="st-0">Waiting</div></span></div>
        <div class="step" id="step-1"><span class="step-num" id="num-1">2</span><span class="step-text"><div class="step-name">Ollama Engine</div><div class="step-status" id="st-1">Waiting</div></span></div>
        <div class="step" id="step-2"><span class="step-num" id="num-2">3</span><span class="step-text"><div class="step-name">Environment</div><div class="step-status" id="st-2">Waiting</div></span></div>
        <div class="step" id="step-3"><span class="step-num" id="num-3">4</span><span class="step-text"><div class="step-name">Dependencies</div><div class="step-status" id="st-3">Waiting</div></span></div>
        <div class="step" id="step-4"><span class="step-num" id="num-4">5</span><span class="step-text"><div class="step-name">AI Model</div><div class="step-status" id="st-4">Waiting</div></span></div>
        <div class="step" id="step-5"><span class="step-num" id="num-5">6</span><span class="step-text"><div class="step-name">Network Access</div><div class="step-status" id="st-5">Waiting</div></span></div>
        <div class="step" id="step-6"><span class="step-num" id="num-6">7</span><span class="step-text"><div class="step-name">Startup Service</div><div class="step-status" id="st-6">Waiting</div></span></div>
    </div>
    <div class="footer-msg" id="msg"></div>
    <div id="log-btn" style="display:none;text-align:center;margin-top:10px">
        <span class="log-link" onclick="openLog()">Open setup.log</span>
    </div>
</div>
</body>
</html>
